# Node.js Server Environment Configuration
PORT=5000
NODE_ENV=production
DATABASE_PATH=./calling_app.db

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_antigravity_calling_2026

# Production Origins & Public URLs
WEB_ORIGIN=https://call.example.com
API_PUBLIC_URL=https://api.example.com

# Dynamic TURN Credentials Setup (Optional for TURN Relay)
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_SECRET=your_production_turn_shared_secret

# Firebase Cloud Messaging (FCM Push Notifications for Mobile)
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
